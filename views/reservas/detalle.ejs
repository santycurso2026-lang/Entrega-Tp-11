<article class="detalle">
  <p class="etiqueta">Estado: <%= reserva.estado %></p>
  <h1><%= reserva.estudiante %></h1>
  
  <p><strong>ID:</strong> <%= reserva._id || reserva.id %></p>
  <p><strong>Email:</strong> <%= reserva.email %></p>
  <p><strong>Sala:</strong> <%= reserva.sala %></p>
  <p><strong>Fecha:</strong> <%= reserva.fecha %></p>
  <p><strong>Turno:</strong> <%= reserva.turno %></p>
  <p><strong>Personas:</strong> <%= reserva.personas %></p>

  <p><a class="boton" href="/reservas/<%= reserva._id || reserva.id %>/editar">Editar reserva</a></p>
  <a href="/reservas">Volver a la lista</a>
</article>